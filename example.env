# Postgres metadata sink (--postgres). Either one URL …
# DATABASE_URL=postgresql://user:pass@localhost:5432/wiki_references
# … or the individual parts (DATABASE=postgres also enables the sink)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wiki_references
DB_USER=postgres
DB_PASS=password

# User-Agent for the Wikimedia API (sync): <AppName>/<Version> (<ContactInfo>)
UA_APP_NAME=RevisionChest
UA_APP_VERSION=0.2.0
UA_CONTACT_INFO=you@example.org

# Minutes between polls with `sync --ongoing`
# SYNC_INTERVAL=10
